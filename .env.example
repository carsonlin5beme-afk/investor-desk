DATABASE_URL=postgresql://investor:investor@localhost:5432/investor_desk?schema=public
# Explicit sample fixtures by default. Set live only after adding provider keys.
MARKET_DATA_MODE=demo
# Set OPTIONS_PROVIDER=alpaca and ALPACA_FEED=sip for consolidated Alpaca SIP + OPRA.
EQUITY_PROVIDER=alpaca
OPTIONS_PROVIDER=tradier
# Reference endpoints are read-only; use api.alpaca.markets for live-account keys.
ALPACA_REFERENCE_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
TRADIER_API_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_BASE_URL=https://www.alphavantage.co
QUOTE_STALE_SECONDS=120
OPTIONS_POLL_SECONDS=20

# Profile sign-in. Use a random 32+ character secret; never commit real secrets.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

# Schwab quotes for simulated portfolios only. Keep demo until checks pass.
# Select EQUITY_PROVIDER=schwab and OPTIONS_PROVIDER=schwab, restart, then
# authorize locally with npm run schwab:connect. Never paste credentials in chat.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
